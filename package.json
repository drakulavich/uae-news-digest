{
  "name": "@drakulavich/uae-news-digest",
  "version": "0.1.1",
  "description": "Daily UAE news digest from Google News RSS with optional DeepL translation",
  "repository": {
    "type": "git",
    "url": "https://github.com/drakulavich/uae-news-digest"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "bin": {
    "uae-news-digest": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test --preload ./test/fetch-guard.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "smoke:pack": "bun scripts/smoke-pack.ts"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
