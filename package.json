{
  "name": "@drakulavich/uae-news-digest",
  "version": "1.0.0",
  "description": "Daily UAE news digest from Google News RSS with optional DeepL translation",
  "repository": {
    "type": "git",
    "url": "https://github.com/drakulavich/uae-news-digest"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "bin": {
    "uae-news-digest": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci && knip --include files,exports,types",
    "check": "bun run typecheck && bun run lint && bun run test",
    "build": "tsc -p tsconfig.build.json",
    "smoke:pack": "bun scripts/smoke-pack.ts"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.3.14",
    "knip": "^6.38.0",
    "typescript": "^7.0.2"
  }
}
