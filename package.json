{
  "name": "@drakulavich/uae-news-digest",
  "version": "0.0.3",
  "description": "Daily UAE news digest from Google News RSS with optional DeepL translation",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "bin": {
    "uae-news-digest": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "smoke:pack": "bun scripts/smoke-pack.ts"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3"
  }
}
